environments:
  default:
    values:
      - ./values/shared-resource-values.yaml
      - ./values/dataflow-resource-values.yaml
      - ./values/multiagent-resource-values.yaml
      - ./values/ui-values.yaml
      - ./values/sso-values.yaml
---

helmDefaults:
  createNamespace: false
  wait: false

releases:

  # Wave 1: Storage Infrastructure
  - name: unifai-dataflow-shared-storage
    chart: ./shared-resources/unifai-dataflow-shared-storage
    version: "0.9.0"
    wait: true
    values:
      - {{- toYaml .Values.storage | nindent 8 }}
      - ./values/global-config.yaml

  # Wave 2: Core Infrastructure Services
  - name: unifai-mongodb
    chart: ./shared-resources/mongodb
    wait: true
    timeout: 300
    needs:
      - unifai-dataflow-shared-storage
    values:
      - {{- toYaml .Values.mongodb | nindent 8 }}

  - name: unifai-qdrant
    chart: ./shared-resources/qdrant
    wait: true
    timeout: 300
    needs:
      - unifai-dataflow-shared-storage
    values:
      - {{- toYaml .Values.qdrant | nindent 8 }}

  - name: unifai-rabbitmq
    chart: ./shared-resources/rabbitmq
    wait: true
    needs:
      - unifai-dataflow-shared-storage
    values:
      - {{- toYaml .Values.rabbitmq | nindent 8 }}

  - name: unifai-docling-service
    chart: ./shared-resources/docling
    wait: true
    timeout: 300
    needs:
      - unifai-dataflow-shared-storage
    values:
      - {{- toYaml .Values.docling | nindent 8 }}

  # Wave 3: Shared Configuration & SSO
  - name: unifai-shared-config
    chart: ./shared-resources/shared-config
    wait: true
    needs:
      - unifai-mongodb
      - unifai-qdrant
      - unifai-rabbitmq
      - unifai-docling-service
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: bash
        args:
          - "-c"
          - |
              set -x  # Print each command
              set +e  # Disable immediate exit on error
              echo "Starting postsync hook..."

              wait_for_port() {
                local svc=$1
                local ip=""
                for i in {1..60}; do
                  port=$(kubectl get svc "$svc" -o jsonpath='{.spec.ports[0].port}' 2>/dev/null)
                  if [[ -n "$port" ]]; then
                    echo "$port"
                    return
                  fi
                  echo "Waiting for $svc Port..."
                  sleep 10
                done
                echo "pending"
              }

              wait_for_service_name() {
                local svc=$1
                local ip=""
                for i in {1..60}; do
                  ip=$(kubectl get svc "$svc" -o jsonpath='{.metadata.name}' 2>/dev/null)
                  if [[ -n "$ip" ]]; then
                    echo "$ip"
                    return
                  fi
                  echo "Waiting for $svc LoadBalancer IP..."
                  sleep 10
                done
                echo "pending"
              }

              wait_for_ext_ip() {
                local svc=$1
                local ip=""
                for i in {1..60}; do
                  ip=$(kubectl get svc "$svc" -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null)
                  if [[ -n "$ip" ]]; then
                    echo "$ip"
                    return
                  fi
                  echo "Waiting for $svc LoadBalancer IP..."
                  sleep 10
                done
                echo "pending"
              }

              MONGODB_ADDR=$(wait_for_ext_ip mongodb)
              QDRANT_ADDR=$(wait_for_ext_ip qdrant)
              RABBITMQ_ADDR=$(wait_for_ext_ip rabbitmq)
              DOCLING_ADDR=$(wait_for_ext_ip docling-serve)
              
              MONGO_PORT=$(wait_for_port mongodb)
              RMQ_PORT=$(wait_for_port rabbitmq)
              DOCLING_PORT=$(wait_for_port docling-serve)

              MONGO_IP=$(wait_for_service_name mongodb)
              RMQ_IP=$(wait_for_service_name rabbitmq)
              DOCLING_IP=$(wait_for_service_name docling-serve)
              

              kubectl delete configmap shared-config
              kubectl create configmap shared-config \
                --from-literal=MONGO_EXT_ADDR="$MONGODB_ADDR" \
                --from-literal=RABBITMQ_EXT_ADDR="$RABBITMQ_ADDR" \
                --from-literal=QDRANT_EXT_ADDR="$QDRANT_ADDR" \
                --from-literal=DOCLING_EXT_ADDR="$DOCLING_ADDR" \
                --from-literal=MONGODB_PORT="$MONGO_PORT" \
                --from-literal=RABBITMQ_PORT="$RMQ_PORT" \
                --from-literal=DOCLING_PORT="$DOCLING_PORT" \
                --from-literal=MONGODB_IP="$MONGO_IP" \
                --from-literal=RABBITMQ_IP="$RMQ_IP" \
                --from-literal=DOCLING_IP="$DOCLING_IP" \
                --dry-run=client -o yaml | kubectl apply -f -

  - name: unifai-sso
    chart: ./shared-resources/sso
    wait: true
    needs:
      - unifai-shared-config
    values:
      - {{- toYaml .Values | nindent 8 }}
      - ./values/global-config.yaml

  # Wave 4: Application Services  
  - name: unifai-dataflow-server
    chart: ./dataflow/unifai-dataflow-server
    wait: true
    needs:
      - unifai-shared-config
    values:
      - {{- toYaml .Values.unifai_dataflow_server | nindent 8 }}
      - ./values/global-config.yaml

  - name: unifai-dataflow-celery
    chart: ./dataflow/unifai-dataflow-celery
    version: "0.9.0"
    wait: true
    needs:
      - unifai-shared-config
    values:
      - {{- toYaml .Values.unifai_dataflow_celery | nindent 8 }}
      - ./values/global-config.yaml

  - name: unifai-dataflow-config
    chart: ./dataflow/unifai-dataflow-config
    wait: true
    needs:
      - unifai-dataflow-server
      - unifai-dataflow-celery
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: bash
        args:
          - "-c"
          - |
              set -x  # Print each command
              set +e  # Disable immediate exit on error
              echo "Starting postsync hook..."

              wait_for_port() {
                local svc=$1
                local ip=""
                for i in {1..60}; do
                  port=$(kubectl get svc "$svc" -o jsonpath='{.spec.ports[0].port}' 2>/dev/null)
                  if [[ -n "$port" ]]; then
                    echo "$port"
                    return
                  fi
                  echo "Waiting for $svc Port..."
                  sleep 10
                done
                echo "pending"
              }

              wait_for_service_name() {
                local svc=$1
                local ip=""
                for i in {1..60}; do
                  ip=$(kubectl get svc "$svc" -o jsonpath='{.metadata.name}' 2>/dev/null)
                  if [[ -n "$ip" ]]; then
                    echo "$ip"
                    return
                  fi
                  echo "Waiting for $svc ClusterIP IP..."
                  sleep 10
                done
                echo "pending"
              }

              wait_for_ip() {
                local svc=$1
                local ip=""
                for i in {1..60}; do
                  ip=$(kubectl get svc "$svc" -o jsonpath='{.spec.clusterIPs[0]}' 2>/dev/null)
                  if [[ -n "$ip" ]]; then
                    echo "$ip"
                    return
                  fi
                  echo "Waiting for $svc ClusterIP IP..."
                  sleep 10
                done
                echo "pending"
              }

              DATAFLOW_ADDR=$(wait_for_ip unifai-dataflow-server)              
              DATAFLOW_PORT=$(wait_for_port unifai-dataflow-server)
              DATAFLOW_IP=$(wait_for_service_name unifai-dataflow-server)
              
              kubectl delete configmap unifai-dataflow-config
              kubectl create configmap unifai-dataflow-config \
                --from-literal=DATAFLOW_ADDR="$DATAFLOW_ADDR" \
                --from-literal=DATAFLOW_PORT="$DATAFLOW_PORT" \
                --from-literal=DATAFLOW_IP="$DATAFLOW_IP" \
                --dry-run=client -o yaml | kubectl apply -f -

  - name: unifai-multiagent-be
    chart: ./multiagent/be
    wait: true
    needs:
      - unifai-shared-config
    values:
      - ./values/global-config.yaml
      - {{- toYaml .Values.multiagent_server | nindent 8 }}

  - name: multiagent-config
    chart: ./multiagent/multiagent-config
    wait: true
    needs:
      - unifai-multiagent-be
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: bash
        args:
          - "-c"
          - |
              set -x  # Print each command
              set +e  # Disable immediate exit on error
              echo "Starting postsync hook..."

              wait_for_port() {
                local svc=$1
                local ip=""
                for i in {1..60}; do
                  port=$(kubectl get svc "$svc" -o jsonpath='{.spec.ports[0].port}' 2>/dev/null)
                  if [[ -n "$port" ]]; then
                    echo "$port"
                    return
                  fi
                  echo "Waiting for $svc Port..."
                  sleep 10
                done
                echo "pending"
              }

              wait_for_service_name() {
                local svc=$1
                local ip=""
                for i in {1..60}; do
                  ip=$(kubectl get svc "$svc" -o jsonpath='{.metadata.name}' 2>/dev/null)
                  if [[ -n "$ip" ]]; then
                    echo "$ip"
                    return
                  fi
                  echo "Waiting for $svc ClusterIP IP..."
                  sleep 10
                done
                echo "pending"
              }

              wait_for_ip() {
                local svc=$1
                local ip=""
                for i in {1..60}; do
                  ip=$(kubectl get svc "$svc" -o jsonpath='{.spec.clusterIPs[0]}' 2>/dev/null)
                  if [[ -n "$ip" ]]; then
                    echo "$ip"
                    return
                  fi
                  echo "Waiting for $svc ClusterIP IP..."
                  sleep 10
                done
                echo "pending"
              }

              MULTIAGENT_ADDR=$(wait_for_ip unifai-multiagent-be)              
              MULTIAGENT_PORT=$(wait_for_port unifai-multiagent-be)
              MULTIAGENT_IP=$(wait_for_service_name unifai-multiagent-be)
              
              kubectl delete configmap multiagent-config
              kubectl create configmap multiagent-config \
                --from-literal=MULTIAGENT_ADDR="$MULTIAGENT_ADDR" \
                --from-literal=MULTIAGENT_PORT="$MULTIAGENT_PORT" \
                --from-literal=MULTIAGENT_IP="$MULTIAGENT_IP" \
                --dry-run=client -o yaml | kubectl apply -f -

  # Wave 5: User Interface
  - name: unifai-ui
    chart: ./ui
    wait: true
    needs:
      - unifai-dataflow-config
      - multiagent-config
      - unifai-sso
    values:
      - {{- toYaml .Values.ui | nindent 8 }}
      - ./values/global-config.yaml
